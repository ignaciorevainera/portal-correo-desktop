# Dependencias y compilación
node_modules/
dist/
dist-electron/
release/

# Archivos de entorno y secretos corporativos (NUNCA rastrear en Git)
.env
.env.*
.env.local
!.env.example
# Configuración heredada (se detecta y elimina en la migración)
cmda.config.json
cmda.config.local.json
# Configuración local del producto (nunca versionar)
portal-correo-desktop.config.json
portal-correo-desktop.config.local.json
*.secure.dat
*.vnc
resources/bin/*.vnc

# Bootstrap generado en build (rutas internas, no secretos)
bootstrap.local.json
electron/bootstrap.default.json

# Reportes y artefactos generados de pruebas y cobertura
coverage/
.nyc_output/
playwright-report/
test-results/
e2e/test-results/
playwright/.cache/

# Logs del sistema, debug y gestores de paquetes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
commit_msg.txt

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*~

# Configuraciones locales de IDEs y editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# Skills tooling & Agent workspace cache
.agents/
skills-lock.json

